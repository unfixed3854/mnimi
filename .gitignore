# No trailing slash: in a worktree this is a symlink, not a directory, and
# `.superpowers/` matches only the latter — leaving it untracked-but-visible,
# where `git add -A` sweeps it into a commit.
.superpowers
.worktrees

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
