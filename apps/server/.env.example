# Copy to .env. Relative filesystem values resolve from the repository root.
DATABASE_URL=file:./data/mnimi.db
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
# Production: public HTTPS API URL, on the same site as the browser frontend.
BETTER_AUTH_URL=http://127.0.0.1:8788
# Exact browser origins, shared by CORS and authentication. Native clients need none.
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081
# Public signup is disabled unless this is exactly true.
REGISTRATION_ENABLED=false
IMAGES_DIR=./data/images
PORT=8788
HOST=0.0.0.0
# Choose exactly one provider. The active defaults below use OpenRouter.
AI_PROVIDER=openrouter
# OpenRouter only; unused when AI_PROVIDER=codex.
OPENROUTER_API_KEY=sk-or-...
CLASSIFY_MODEL=~deepseek/deepseek-v4-flash-latest
CLASSIFY_EFFORT=low
GENERATE_MODEL=~deepseek/deepseek-v4-flash-latest
GENERATE_EFFORT=high
# OpenRouter only; Codex image generation uses the service-selected image model.
IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# Codex provider (private personal instances only): replace, rather than add to,
# the active AI_PROVIDER and all four role model/effort values above before using:
# AI_PROVIDER=codex
# CLASSIFY_MODEL=gpt-5.6-luna
# CLASSIFY_EFFORT=low
# GENERATE_MODEL=gpt-5.6-sol
# GENERATE_EFFORT=high
# CODEX_HOME=./data/codex
# REGISTRATION_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
AUDIO_DIR=./data/audio
