{
  "name": "@mnimi/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "type": "commonjs",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web --port 8081",
    "build:web": "expo export --platform web",
    "check": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand && bun test ./scripts/build-android.test.ts ./scripts/app-icon-config.test.ts ./scripts/nativewind-config.test.ts",
    "smoke": "bash e2e/android-smoke.sh",
    "build:android": "bun --env-file=.env scripts/build-android.ts",
    "expo:config": "expo config --type public"
  },
